# Mattermost
MM_URL=https://your-mattermost.com
MM_BOT_TOKEN=your-bot-token
MM_BOT_USERNAME=pm-bot
MM_BOT_USER_ID=

# Outline (self-hosted)
OUTLINE_URL=https://wiki.yourcompany.com
OUTLINE_API_TOKEN=your-outline-token

# Plane (self-hosted)
PLANE_URL=https://plane.yourcompany.com
PLANE_API_KEY=plane_api_...
PLANE_WORKSPACE_SLUG=your-workspace-slug

# Fathom
FATHOM_API_KEY=your-fathom-api-key

# Database (shared with knowledge-bot)
DB_PATH=/app/data/kb-bot.db

# Volume mount source on the host — directory that contains kb-bot.db.
KB_DATA_DIR=./data

# Misc
CLEANUP_INTERVAL_MINUTES=60
